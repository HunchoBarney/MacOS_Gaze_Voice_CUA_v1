+#[tokio::test]
+async fn synthetic_scroll_publishes_only_measured_directional_effects() {
+    for (value, expected) in [
+        (json!({"connected": true, "max_x": 1000, "max_y": 1000, "before_x": 0, "before_y": 0, "after_x": 0, "after_y": 500}), "confirmed"),
+        (json!({"connected": true, "max_x": 1000, "max_y": 1000, "before_x": 0, "before_y": 0, "after_x": 0, "after_y": 100}), "unverifiable"),
+        (json!({"connected": true, "max_x": 1000, "max_y": 1000, "before_x": 0, "before_y": 900, "after_x": 0, "after_y": 1000}), "confirmed"),
+        (json!({"connected": true, "max_x": 1000, "max_y": 1000, "before_x": 0, "before_y": 1000, "after_x": 0, "after_y": 1000}), "suspected_noop"),
+        (json!({"connected": true, "max_x": 1000, "max_y": 1000, "before_x": 0, "before_y": 500, "after_x": 0, "after_y": 0}), "unverifiable"),
+        (json!({"connected": true, "max_x": 1000, "max_y": 1000, "before_x": 0, "before_y": 0, "after_x": 0, "after_y": 1000}), "unverifiable"),
+        (json!({"connected": true, "max_x": 1000, "max_y": 1000, "before_x": 0, "before_y": 0, "after_x": 10, "after_y": 500}), "unverifiable"),
+        (json!({"connected": true, "max_x": 1000, "max_y": 1000, "before_x": 0, "after_y": 500}), "unverifiable"),
+        (json!({"connected": false, "max_x": 1000, "max_y": 1000, "before_x": 0, "before_y": 0, "after_x": 0, "after_y": 500}), "unverifiable"),
+        (json!(true), "unverifiable"),
+        (Value::Null, "unverifiable"),
+    ] {
+        let f = fixture_with(|st| st.dom_function_value = value).await;
+        let (target, tab) = bind(&f).await;
+        let snap = snapshot(&f, &target, &tab).await;
+        let main_ref = ref_of(&snap, "main", "main-btn");
+        let args = json!({"target_id": target, "tab_id": tab, "ref": main_ref,
+            "session": SESSION, "action": "scroll", "input_route": "dom_event", "delta_y": 500});
+        let result = BrowserPointerTool::new(f.engine.clone()).invoke(args.clone()).await;
+        let record = result.action_record.clone().or_else(||
+            ActionExecutionRecord::from_legacy("browser_pointer", &args, structured(&result)))
+            .expect("scroll action record");
+        let public = serde_json::to_value(record.public_result().unwrap()).unwrap();
+        assert_eq!(public["effect"], expected, "{public}");
+        assert_eq!(public["route"], "dom");
+        assert_eq!(public["delivery"]["mode"], "background");
+        assert_eq!(public["evidence"].as_array().is_some_and(|e| !e.is_empty()), expected == "confirmed");
+        assert_eq!(recorded_calls(&f, "Runtime.callFunctionOn").len(), 1, "No mutation retry");
+        assert!(recorded_calls(&f, "DOM.scrollIntoViewIfNeeded").is_empty(), "Visual preparation must not introduce an unmeasured scroll");
+        assert!(recorded_calls(&f, "Page.bringToFront").is_empty());
+        assert!(recorded_calls(&f, "Target.activateTarget").is_empty());
+    }
+}
