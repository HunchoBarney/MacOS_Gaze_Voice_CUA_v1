+/// Under `--host-connections-only` a connection is served only when it is the
+/// authenticated embedded host's own; otherwise every authenticated local
+/// peer is served as before.
+fn admits_connection(host_connections_only: bool, trusted_host_connection: bool) -> bool {
+    !host_connections_only || trusted_host_connection
+}
