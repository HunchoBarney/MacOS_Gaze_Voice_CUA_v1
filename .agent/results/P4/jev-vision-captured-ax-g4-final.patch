+#[derive(Debug)]
+struct NativeCaptureRefusal(ToolResult);
+
+impl std::fmt::Display for NativeCaptureRefusal {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("capture-bound input refused")
+    }
+}
+
+impl std::error::Error for NativeCaptureRefusal {}
+
+pub(super) fn guarded_input<T>(
+    admission: Option<&dyn CapturedInputAdmission>,
+    args: &serde_json::Value,
+    input: impl FnOnce() -> anyhow::Result<T>,
+) -> anyhow::Result<T> {
+    if let Some(admission) = admission {
+        admission
+            .validate_live(args)
+            .map_err(NativeCaptureRefusal)?;
+        admission.mark_input_attempted();
+    }
+    input()
+}
+
+pub(super) fn require_captured_ax_action(
+    admission: Option<&dyn CapturedInputAdmission>,
+    action: &str,
+    advertised: &[String],
+) -> anyhow::Result<()> {
+    if admission.is_some_and(CapturedInputAdmission::is_element)
+        && !advertised.iter().any(|candidate| candidate == action)
+    {
+        return Err(NativeCaptureRefusal(capture_error(
+            "capture_element_unsupported",
+            "captured native target does not support this AX action",
+        ))
+        .into());
+    }
+    Ok(())
+}
+
+pub(super) fn guarded_ax_input<T>(
+    admission: Option<&dyn CapturedInputAdmission>,
+    element: usize,
+    action: &str,
+    advertised: &[String],
+    input: impl FnOnce() -> anyhow::Result<T>,
+) -> anyhow::Result<T> {
+    require_captured_ax_action(admission, action, advertised)?;
+    if let Some(admission) = admission {
+        admission.before_ax_input(element)?;
+    }
+    input()
+}
+
+pub(super) fn native_refusal(error: anyhow::Error) -> Result<ToolResult, anyhow::Error> {
+    error
+        .downcast::<NativeCaptureRefusal>()
+        .map(|refusal| refusal.0)
+}
 
