{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "acceptance.schema.json",
  "title": "Phase acceptance file — default FAIL",
  "type": "object",
  "required": ["phase", "criteria"],
  "additionalProperties": false,
  "properties": {
    "phase": { "type": "string", "pattern": "^P[0-9]+[a-z]?$" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "behavior", "check", "expected", "passes", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]+[a-z]?-[0-9]+$" },
          "behavior": { "type": "string", "minLength": 1 },
          "check": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "passes": { "type": "boolean" },
          "evidence": { "type": ["string", "null"] }
        }
      }
    }
  }
}
