+// Measure the same retained DOM target around delivery. Include wheel-listener
+// effects in the measurement, so an unexpected extra movement cannot confirm
+// the requested delta. This does not turn a page handler's acknowledgement into
+// proof and does not retry a missing response.
+const DOM_SCROLL_FUNCTION: &str = r#"function(dx,dy) {
+    const doc=this.ownerDocument;
+    let n=this;
+    while (n && n !== doc.documentElement) {
+        const s=doc.defaultView.getComputedStyle(n);
+        if (/(auto|scroll)/.test(s.overflow+s.overflowX+s.overflowY)) break;
+        n=n.parentElement;
+    }
+    const target=n || doc.scrollingElement || doc.documentElement;
+    const belongs=()=>this.isConnected && target.isConnected && this.ownerDocument === doc
+        && target.ownerDocument === doc && (target === this || target.contains(this));
+    if (!belongs()) return {connected:false};
+    const beforeX=target.scrollLeft, beforeY=target.scrollTop;
+    const maxX=Math.max(0,target.scrollWidth-target.clientWidth), maxY=Math.max(0,target.scrollHeight-target.clientHeight);
+    const o={deltaX:dx,deltaY:dy,bubbles:true,cancelable:true,composed:true,view:doc.defaultView};
+    this.dispatchEvent(new WheelEvent('wheel',o));
+    if (!belongs()) return {connected:false};
+    target.scrollBy(dx,dy);
+    if (target.scrollLeft !== beforeX || target.scrollTop !== beforeY) target.dispatchEvent(new Event('scroll'));
+    return {connected:belongs()
+            && maxX === Math.max(0,target.scrollWidth-target.clientWidth) && maxY === Math.max(0,target.scrollHeight-target.clientHeight),
+        max_x:maxX,max_y:maxY,before_x:beforeX,before_y:beforeY,after_x:target.scrollLeft,after_y:target.scrollTop};
+}"#;
+
+fn scroll_readback_record(value: &Value, delta_x: f64, delta_y: f64) -> ActionExecutionRecord {
+    let offsets: Option<Vec<f64>> = ["before_x", "before_y", "after_x", "after_y", "max_x", "max_y"]
+        .iter().map(|key| value.get(key)?.as_f64().filter(|v| v.is_finite())).collect();
+    let effect = match offsets {
+        Some(v) if value.get("connected").and_then(Value::as_bool) == Some(true) => {
+            let x = v[2] - v[0];
+            let y = v[3] - v[1];
+            let in_bounds = |before: f64, after: f64, max: f64| max >= 0.0
+                && before >= 0.0 && before <= max && after >= 0.0 && after <= max;
+            let agrees = |before: f64, after: f64, requested: f64, max: f64|
+                after == (before + requested).clamp(0.0, max);
+            if !in_bounds(v[0], v[2], v[4]) || !in_bounds(v[1], v[3], v[5]) { ActionEffect::Unverifiable }
+            else if x == 0.0 && y == 0.0 { ActionEffect::SuspectedNoop }
+            else if agrees(v[0], v[2], delta_x, v[4]) && agrees(v[1], v[3], delta_y, v[5]) { ActionEffect::Confirmed }
+            else { ActionEffect::Unverifiable }
+        }
+        _ => ActionEffect::Unverifiable,
+    };
+    let mut record = ActionExecutionRecord::new(effect, ActionTransport::BrowserCdpRuntimeFunction,
+        RequestedDelivery::NotApplicable);
+    record.actual_delivery = Some(ActualDelivery::Background);
+    if effect == ActionEffect::Confirmed {
+        record.evidence.push(ActionEvidence { kind: EvidenceKind::BrowserReadback,
+            detail: "Retained DOM scroll target reached the requested offset, clipped only by measured unchanged bounds".into() });
+    }
+    record
+}

