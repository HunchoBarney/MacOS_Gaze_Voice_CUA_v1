+    func testC1WindowPrimitiveRequestRetainsArgumentsScopeAndAuthorityBoundary() async throws {
+        let button = DriveLoop.Element(index: 7, token: "native-button-token",
+            role: "AXButton", label: "Open", value: nil,
+            frame: (10, 10, 120, 30), actions: ["AXPress"])
+        var drafts = DriveCandidates.drafts(elements: [button], snapshotID: "native-snapshot",
+            windowTitle: "Owned", goal: "scroll down", cap: nil, url: nil)
+        drafts.append(.init(id: "media", description: "volume up",
+            kind: .request(.init(effect: .tool, tool: "media key",
+                                  args: ["key": .string("volumeUp")], summary: "volume up"))))
+        let actions = drafts.filter { !["done", "reobserve", "stuck"].contains($0.id) }
+            .map { (id: $0.id, description: $0.description) }
+        let primitiveIDs = Set(["key:return", "key:escape", "key:tab", "scroll:up", "scroll:down"])
+        let arguments = Dictionary(uniqueKeysWithValues: drafts.compactMap { draft -> (String, JSONValue)? in
+            guard primitiveIDs.contains(draft.id), case .request(let request) = draft.kind else { return nil }
+            return (draft.id, .object(request.args))
+        })
+        XCTAssertEqual(Set(arguments.keys), primitiveIDs)
+        for (app, window) in [("owned.application", "Owned"), ("", "")] {
+            var fields = DriveCandidates.observationFields(elements: [button], candidates: drafts,
+                goal: "scroll down", values: [:])
+            fields["app"] = .string("wrong.application")
+            fields["window"] = .string("Wrong window")
+            let untouched = JSONValue.object(fields)
+            let state = DriveCandidates.stateJSON(goal: "scroll down", app: app, window: window,
+                options: actions.map(\.description), recentSteps: [], context: nil,
+                snapshotID: "native-snapshot", fields: fields)
+            XCTAssertEqual(.object(fields), untouched)
+            let called = LockedBox(false)
+            let choose = JevChooser.make(model: "jev-1.14.0") { captured, _ in
+                called.set(true)
+                XCTAssertEqual(captured["app"]?.string, app)
+                XCTAssertEqual(captured["window"]?.string, window)
+                XCTAssertEqual(captured["available_actions"]?.array?.compactMap { $0["id"]?.string },
+                               actions.map(\.id))
+                for (id, actualArguments) in arguments {
+                    let detail = try XCTUnwrap(captured["candidate_details"]?[id])
+                    XCTAssertEqual(detail["arguments"], actualArguments)
+                    XCTAssertEqual(detail["target_scope"], .object([
+                        "kind": .string("window"), "app": .string(app), "window": .string(window),
+                    ]))
+                    for authority in ["pid", "window_id", "session", "permission", "authorized", "verified"] {
+                        XCTAssertNil(detail[authority])
+                        XCTAssertNil(detail["arguments"]?[authority])
+                        XCTAssertNil(detail["target_scope"]?[authority])
+                    }
+                }
+                XCTAssertNil(captured["candidate_details"]?["e7"]?["target_scope"])
+                XCTAssertNil(captured["candidate_details"]?["e7"]?["arguments"])
+                XCTAssertNil(captured["candidate_details"]?["media"]?["target_scope"])
+                XCTAssertNil(captured["candidate_details"]?["media"]?["arguments"])
+                throw RequestCaptured.stop
+            }
+            do {
+                _ = try await choose(state, actions + [(id: "done", description: "Goal satisfied")])
+                XCTFail("Capture must stop before inference")
+            } catch RequestCaptured.stop {}
+            XCTAssertTrue(called.value)
+            XCTAssertEqual(.object(fields), untouched)
+            for draft in drafts where primitiveIDs.contains(draft.id) {
+                guard case .request(let request) = draft.kind else { return XCTFail("Missing primitive request") }
+                XCTAssertEqual(.object(request.args), arguments[draft.id])
+            }
+        }
+    }
