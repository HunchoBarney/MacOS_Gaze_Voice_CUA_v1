+#[derive(Debug)]
+pub struct WindowPixelRequest {
+    pub capture_id: String,
+    pub pid: i32,
+    pub window_id: u32,
+    pub x: f64,
+    pub y: f64,
+}
+
+#[derive(Debug)]
+pub struct WindowElementRequest {
+    pub capture_id: String,
+    pub pid: i32,
+    pub window_id: u32,
+    pub element_token: String,
+}
+
+impl WindowElementRequest {
+    pub fn decode(args: &Value) -> Result<Option<Self>, ToolResult> {
+        if args.get("capture_id").is_none() || args.get("element_token").is_none() {
+            return Ok(None);
+        }
+        if ["x", "y", "element_index", "snapshot_id"]
+            .iter()
+            .any(|key| args.get(key).is_some())
+        {
+            return Err(invalid_capture_input());
+        }
+        let (capture_id, pid, window_id) = window_capture_identity(args)?;
+        let token = args
+            .get("element_token")
+            .and_then(Value::as_str)
+            .filter(|token| crate::element_token::parse_token(token).is_some())
+            .ok_or_else(invalid_capture_input)?;
+        Ok(Some(Self {
+            capture_id,
+            pid,
+            window_id,
+            element_token: token.to_owned(),
+        }))
+    }
+}
+
+fn invalid_capture_input() -> ToolResult {
+    ToolResult::error("capture_id requires an exact window and either pixel coordinates or a native element token.")
+        .with_structured(serde_json::json!({"code":"invalid_capture_input", "effect":"refused"}))
+}
+
+fn window_capture_identity(args: &Value) -> Result<(String, i32, u32), ToolResult> {
+    let capture_id = args
+        .get("capture_id")
+        .and_then(Value::as_str)
+        .filter(|id| !id.trim().is_empty())
+        .ok_or_else(invalid_capture_input)?;
+    if args
+        .get("scope")
+        .is_some_and(|scope| scope.as_str() != Some("window"))
+        || args
+            .get("from_zoom")
+            .is_some_and(|zoom| zoom.as_bool() != Some(false))
+    {
+        return Err(invalid_capture_input());
+    }
+    let target = args.get("target");
+    if target.is_some_and(|target| target.get("kind").and_then(Value::as_str) != Some("window")) {
+        return Err(invalid_capture_input());
+    }
+    let identity = |key: &str| -> Result<i64, ToolResult> {
+        let flat = args.get(key);
+        let nested = target.and_then(|target| target.get(key));
+        if flat.is_some() && nested.is_some() && flat != nested {
+            return Err(invalid_capture_input());
+        }
+        flat.or(nested)
+            .and_then(Value::as_i64)
+            .filter(|value| *value > 0)
+            .ok_or_else(invalid_capture_input)
+    };
+    Ok((
+        capture_id.to_owned(),
+        i32::try_from(identity("pid")?).map_err(|_| invalid_capture_input())?,
+        u32::try_from(identity("window_id")?).map_err(|_| invalid_capture_input())?,
+    ))
+}
+
+impl WindowPixelRequest {
+    pub fn decode(args: &Value) -> Result<Option<Self>, ToolResult> {
+        if args.get("capture_id").is_none() {
+            return Ok(None);
+        }
+        let invalid = invalid_capture_input;
+        if ["element_index", "element_token", "snapshot_id"]
+            .iter()
+            .any(|key| args.get(key).is_some())
+        {
+            return Err(invalid());
+        }
+        let (capture_id, pid, window_id) = window_capture_identity(args)?;
+        let point = |key: &str| {
+            args.get(key)
+                .and_then(Value::as_f64)
+                .filter(|value| value.is_finite() && *value >= 0.0)
+                .ok_or_else(invalid)
+        };
+        Ok(Some(Self {
+            capture_id,
+            pid,
+            window_id,
+            x: point("x")?,
+            y: point("y")?,
+        }))
+    }
+}
+
+pub fn unsupported_capture_input(args: &Value) -> Option<ToolResult> {
+    args.get("capture_id").map(|_| {
+        ToolResult::error("This platform adapter does not support capture-bound window input.")
+            .with_structured(serde_json::json!({
+                "code": if args.get("element_token").is_some() {
+                    "capture_element_unsupported"
+                } else { "capture_binding_unsupported" }, "effect": "refused"
+            }))
+    })
+}
