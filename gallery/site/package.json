{
  "name": "jarvis-ui-gallery",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "collect": "node scripts/collect.mjs",
    "sample": "node scripts/make-sample.mjs && node scripts/make-redesign-sample.mjs && node scripts/collect.mjs --renders sample/renders --findings sample/findings.json"
  },
  "dependencies": {
    "@number-flow/react": "0.6.2",
    "@paper-design/shaders-react": "0.0.82",
    "cmdk": "1.1.1",
    "lenis": "1.3.27",
    "motion": "14.14.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "2.0.8",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
