+
+/// A detached launch guard whose observer and timer share one retirement gate.
+/// Keep the entry until this owner drops, even after its observer deadline, so
+/// an explicit foreground request can still stop the remainder of the timer.
+pub(crate) struct LaunchWatchdog {
+    _lease: SuppressionLease,
+    active: Arc<Mutex<bool>>,
+}
+
+impl LaunchWatchdog {
+    pub(crate) fn restore_if_active(&self, restore: impl FnOnce()) -> bool {
+        let active = self.active.lock().unwrap();
+        if !*active {
+            return false;
+        }
+        restore();
+        true
+    }
+}
+
+impl Drop for LaunchWatchdog {
+    fn drop(&mut self) {
+        *self.active.lock().unwrap() = false;
+    }
+}
+
+struct RestoreRequest {
+    pid: i32,
+    launch_watchdog: Option<Arc<Mutex<bool>>>,
+}
+
+impl RestoreRequest {
+    fn run(&self, restore: impl FnOnce()) {
+        // Hold the gate through the OS request: retirement waits for any
+        // already-running restore before the intentional activation begins.
+        let active = self
+            .launch_watchdog
+            .as_ref()
+            .map(|gate| gate.lock().unwrap());
+        if active.as_ref().is_none_or(|active| **active) {
+            restore();
+        }
+    }
 }
 
