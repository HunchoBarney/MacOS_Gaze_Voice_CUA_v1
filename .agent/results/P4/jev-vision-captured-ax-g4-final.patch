+pub(super) struct AdmittedWindowPixel {
+    service: Arc<CaptureService>,
+    admission: CaptureActionAdmission,
+    request: WindowPixelRequest,
+    kind: WindowPixelAction,
+    foreground: bool,
+    input_attempted: AtomicBool,
+    origin_args: serde_json::Value,
+}
+
+impl AdmittedWindowPixel {
+    pub(super) fn window_identity(&self) -> (i32, u32) {
+        (self.request.pid, self.request.window_id)
+    }
+
+    pub(super) fn action_point(&self) -> (f64, f64) {
+        (self.admission.action_x, self.admission.action_y)
+    }
+
+    pub(super) fn window_coordinates(&self) -> Result<(f64, f64, f64, f64), ToolResult> {
+        let dimensions = self.admission.native_action_dimensions;
+        let bounds = dimensions.window_bounds().ok_or_else(|| {
+            capture_error(
+                "capture_frame_mismatch",
+                "captured window geometry is unavailable",
+            )
+        })?;
+        let (x, y) = self.action_point();
+        let local_x = x * bounds[2] / f64::from(dimensions.width());
+        let local_y = y * bounds[3] / f64::from(dimensions.height());
+        if !local_x.is_finite()
+            || !local_y.is_finite()
+            || local_x < 0.0
+            || local_y < 0.0
+            || local_x >= bounds[2]
+            || local_y >= bounds[3]
+        {
+            return Err(capture_error(
+                "capture_coordinate_invalid",
+                "mapped point is outside the captured window",
+            ));
+        }
+        Ok((bounds[0] + local_x, bounds[1] + local_y, local_x, local_y))
+    }
+
+    pub(super) fn mark_input_attempted(&self) {
+        self.input_attempted.store(true, Ordering::Release);
+    }
+
+    pub(super) fn before_input(&self) -> anyhow::Result<()> {
+        guarded_input(Some(self), &self.origin_args, || Ok(()))
+    }
+
+    pub(super) fn before_key_input(&self) -> anyhow::Result<()> {
+        self.validate_live(&self.origin_args)
+            .map_err(NativeCaptureRefusal)?;
+        self.validate_key_context(
+            crate::ax::bindings::focused_window_id_of_pid(self.request.pid),
+            crate::apps::frontmost_pid(),
+        )
+        .map_err(NativeCaptureRefusal)?;
+        self.mark_input_attempted();
+        Ok(())
+    }
+
+    pub(super) fn before_ax_input(&self, element: usize) -> anyhow::Result<()> {
+        self.validate_live(&self.origin_args)
+            .map_err(NativeCaptureRefusal)?;
+        let matches = unsafe {
+            crate::ax::exact_target::element_window_id(
+                element as crate::ax::bindings::AXUIElementRef,
+            )
+        }
+        .is_some_and(|window| window.is(self.request.window_id));
+        if !matches {
+            return Err(NativeCaptureRefusal(self.with_partial_effect(capture_error(
+                "capture_target_mismatch",
+                "AX target no longer belongs to the captured window",
+            )))
+            .into());
+        }
+        self.mark_input_attempted();
+        Ok(())
+    }
+
+    pub(super) fn before_pointer_input(&self, foreground: bool) -> anyhow::Result<()> {
+        self.validate_live(&self.origin_args)
+            .map_err(NativeCaptureRefusal)?;
+        if foreground {
+            if !self.foreground {
+                return Err(NativeCaptureRefusal(self.with_partial_effect(capture_error(
+                    "capture_target_mismatch",
+                    "foreground input was not admitted",
+                )))
+                .into());
+            }
+            self.validate_key_context(
+                crate::ax::bindings::focused_window_id_of_pid(self.request.pid),
+                crate::apps::frontmost_pid(),
+            )
+            .map_err(NativeCaptureRefusal)?;
+        }
+        self.mark_input_attempted();
+        Ok(())
+    }
+
+    fn validate_key_context(
+        &self,
+        focused: Option<crate::ax::exact_target::AxWindowId>,
+        front: Option<i32>,
+    ) -> Result<(), ToolResult> {
+        if !focused.is_some_and(|window| window.is(self.request.window_id))
+            || (self.foreground && front != Some(self.request.pid))
+        {
+            return Err(self.with_partial_effect(capture_error(
+                "capture_target_mismatch",
+                "keyboard or foreground target changed after admission",
+            )));
+        }
+        Ok(())
+    }
+
+    pub(super) fn finish_result(&self, result: ToolResult) -> ToolResult {
+        if result.is_error == Some(true) {
+            self.with_partial_effect(result)
+        } else {
+            result
+        }
+    }
+
+    pub(super) fn validate_live(&self, args: &serde_json::Value) -> Result<(), ToolResult> {
+        let dimensions = live_action_dimensions(&self.admission.target)
+            .map_err(|refusal| self.with_partial_effect(refusal))?;
+        self.validate_with_frame(args, dimensions)
+    }
+
+    fn validate_with_frame(
+        &self,
+        args: &serde_json::Value,
+        dimensions: NativeActionDimensions,
+    ) -> Result<(), ToolResult> {
+        let binding = self.service.binding_from_args(args).map_err(|error| {
+            self.with_partial_effect(capture_error("capture_binding_failed", error))
+        })?;
+        if &binding != self.admission.binding() {
+            return Err(self.with_partial_effect(capture_error(
+                "capture_generation_mismatch",
+                "input owner differs from captured owner",
+            )));
+        }
+        self.service
+            .validate_admission(&self.admission, dimensions)
+            .map_err(|error| self.with_partial_effect(capture_error(error.wire_code(), error)))
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn validate_child_context(
+        &self,
+        args: &serde_json::Value,
+        kind: WindowPixelAction,
+        pid: i32,
+        window_id: u32,
+        x: f64,
+        y: f64,
+        foreground: bool,
+    ) -> Result<(), ToolResult> {
+        let allowed_kind = kind == self.kind
+            || (kind == WindowPixelAction::Click
+                && matches!(
+                    self.kind,
+                    WindowPixelAction::TypeText | WindowPixelAction::PressKey
+                ));
+        let borrowed_focus =
+            kind == WindowPixelAction::Click && self.kind != WindowPixelAction::Click;
+        let invalid_focus = borrowed_focus
+            && (args
+                .get("button")
+                .is_some_and(|value| value.as_str() != Some("left"))
+                || args
+                    .get("count")
+                    .is_some_and(|value| value.as_u64() != Some(1))
+                || args
+                    .get("action")
+                    .is_some_and(|value| !matches!(value.as_str(), Some("focus" | "press")))
+                || args
+                    .get("modifiers")
+                    .is_some_and(|value| !value.as_array().is_some_and(Vec::is_empty)));
+        if !allowed_kind
+            || invalid_focus
+            || pid != self.request.pid
+            || window_id != self.request.window_id
+            || x != self.request.x
+            || y != self.request.y
+            || (foreground && !self.foreground)
+            || args
+                .get("capture_id")
+                .is_some_and(|id| id.as_str() != Some(self.request.capture_id.as_str()))
+        {
+            return Err(self.with_partial_effect(capture_error(
+                "capture_target_mismatch",
+                "child input differs from the admitted primitive",
+            )));
+        }
+        let binding = self.service.binding_from_args(args).map_err(|error| {
+            self.with_partial_effect(capture_error("capture_binding_failed", error))
+        })?;
+        if &binding != self.admission.binding() {
+            return Err(self.with_partial_effect(capture_error(
+                "capture_generation_mismatch",
+                "child input owner differs from captured owner",
+            )));
+        }
+        Ok(())
+    }
+
+    fn with_partial_effect(&self, refusal: ToolResult) -> ToolResult {
+        partial_effect(refusal, self.input_attempted.load(Ordering::Acquire))
+    }
+}
+
+fn partial_effect(mut refusal: ToolResult, attempted: bool) -> ToolResult {
+    if attempted {
+        let detail = refusal
+            .structured_content
+            .get_or_insert_with(|| serde_json::json!({}));
+        if !detail.is_object() {
+            *detail = serde_json::json!({ "detail": detail.take() });
+        }
+        detail["effect"] = serde_json::json!("unverifiable");
+        detail["input_may_have_dispatched"] = serde_json::json!(true);
+        detail["later_input_refused"] = serde_json::json!(true);
+        detail["retryable"] = serde_json::json!(false);
+        detail
+            .as_object_mut()
+            .unwrap()
+            .remove("retry_from_character");
+        if let Some(record) = refusal.action_record.as_mut() {
+            record.effect = cua_driver_core::action_record::ActionEffect::Unverifiable;
+            record
+                .actual_delivery
+                .get_or_insert(cua_driver_core::action_record::ActualDelivery::Unknown);
+            record.refusal = None;
+        }
+    }
+    refusal
+}
