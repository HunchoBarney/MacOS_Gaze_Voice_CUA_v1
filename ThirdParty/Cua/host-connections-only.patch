+/// Embedded-host lockdown: when set to the exact value `1`, the service
+/// socket admits only the embedded host itself (the peer whose PID is the
+/// daemon's parent). Every other local peer is dropped before its first
+/// request is read, so another process of the same user cannot reach the
+/// tools by finding the socket.
+pub const HOST_CONNECTIONS_ONLY_ENV: &str = "CUA_DRIVER_HOST_CONNECTIONS_ONLY";
+
+/// Only the exact value `1` enables it; anything else leaves the socket as
+/// before. Enforcement fails closed: outside embedded mode no peer
+/// authenticates as the host, so every connection is refused.
+pub fn host_connections_only() -> bool {
+    std::env::var_os(HOST_CONNECTIONS_ONLY_ENV).is_some_and(|value| value == "1")
+}
