+pub(super) struct AdmittedWindowElement {
+    service: Arc<CaptureService>,
+    admission: CaptureElementAdmission,
+    request: WindowElementRequest,
+    snapshots: Weak<Snapshots>,
+    retained: RetainedElement,
+    kind: WindowPixelAction,
+    foreground: bool,
+    input_attempted: AtomicBool,
+    origin_args: serde_json::Value,
+}
+
+impl AdmittedWindowElement {
+    fn with_partial_effect(&self, refusal: ToolResult) -> ToolResult {
+        partial_effect(refusal, self.input_attempted.load(Ordering::Acquire))
+    }
+
+    fn validate_with_frame(
+        &self,
+        args: &serde_json::Value,
+        dimensions: NativeActionDimensions,
+    ) -> Result<(), ToolResult> {
+        let binding = self.service.binding_from_args(args).map_err(|error| {
+            self.with_partial_effect(capture_error("capture_binding_failed", error))
+        })?;
+        if &binding != self.admission.binding() {
+            return Err(self.with_partial_effect(capture_error(
+                "capture_generation_mismatch",
+                "input owner changed",
+            )));
+        }
+        let current = WindowElementRequest::decode(args)
+            .map_err(|refusal| self.with_partial_effect(refusal))?
+            .ok_or_else(|| {
+                self.with_partial_effect(capture_error(
+                    "invalid_capture_input",
+                    "native capture identity is missing",
+                ))
+            })?;
+        if current.pid != self.request.pid || current.window_id != self.request.window_id {
+            return Err(self.with_partial_effect(capture_error(
+                "capture_target_mismatch",
+                "native target identity changed",
+            )));
+        }
+        if args.get("capture_id").and_then(serde_json::Value::as_str)
+            != Some(&self.request.capture_id)
+            || args
+                .get("element_token")
+                .and_then(serde_json::Value::as_str)
+                != Some(self.request.element_token.as_str())
+            || args.get("x").is_some()
+            || args.get("y").is_some()
+        {
+            return Err(self.with_partial_effect(capture_error(
+                "invalid_capture_input",
+                "captured native target changed",
+            )));
+        }
+        let current_snapshot = self.snapshots.upgrade().and_then(|snapshots| {
+            match snapshots
+                .resolve(self.request.pid, &self.origin_args)
+                .ok()?
+            {
+                ResolvedElement::Element {
+                    window_id,
+                    element_index,
+                    element,
+                } if window_id == u64::from(self.request.window_id)
+                    && element_index == self.admission.element_index
+                    && element.as_ptr() == self.retained.as_ptr() =>
+                {
+                    Some(self.admission.snapshot_id)
+                }
+                _ => None,
+            }
+        });
+        self.service
+            .validate_element_admission(&self.admission, dimensions, current_snapshot)
+            .map_err(|error| self.with_partial_effect(capture_error(error.wire_code(), error)))
+    }
+
+    fn validate_focus(&self) -> anyhow::Result<()> {
+        if !crate::ax::bindings::focused_window_id_of_pid(self.request.pid)
+            .is_some_and(|window| window.is(self.request.window_id))
+            || (self.foreground && crate::apps::frontmost_pid() != Some(self.request.pid))
+        {
+            return Err(NativeCaptureRefusal(self.with_partial_effect(capture_error(
+                "capture_target_mismatch",
+                "native keyboard or foreground context changed",
+            )))
+            .into());
+        }
+        Ok(())
+    }
+}
