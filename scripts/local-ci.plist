<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for make local-ci-install, which fills in @CI_HOME@. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.karanvirkang.jarvis.local-ci</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@CI_HOME@/bin/local-ci.sh</string>
        <string>poll</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LOCAL_CI_HOME</key>
        <string>@CI_HOME@</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@CI_HOME@/logs/poll.log</string>
    <key>StandardErrorPath</key>
    <string>@CI_HOME@/logs/poll.log</string>
</dict>
</plist>
