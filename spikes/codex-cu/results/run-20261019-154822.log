time-cache", "skill://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/vercel-agent", "skill://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/vercel-cli", "skill://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/vercel-connect", "skill://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/vercel-firewall", "skill://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/vercel-functions", "skill://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/vercel-sandbox", "skill://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/vercel-services", "skill://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/vercel-storage", "skill://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/verification", "skill://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/workflow"], "requires_executor": false, "mcp_servers": [{"key": "vercel"}], "contents": ["bundle"], "bundle": "plugin://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/bundle"}}, {"description": "**MANDATORY prerequisite** \u2014 you MUST invoke this skill BEFORE every `use_figma` tool call. NEVER call `use_figma` directly without loading this skill first. Skipping it causes common, hard-to-debug failures. Trigger whenever the user wants to perform a write action or a unique read action that requires JavaScript execution in the Figma file context \u2014 e.g. create/edit/delete nodes, set up variables or tokens, build components and variants, modify auto-layout or fills, bind variables to properties, or inspect file structure programmatically.", "mimeType": "mcp/skill", "name": "plugin_connector_68df038e0ba48191908c8434991bbac2/figma-use", "title": "figma-use", "uri": "skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-use", "_meta": {"plugin_id": "plugin_connector_68df038e0ba48191908c8434991bbac2", "plugin_name": "figma", "plugin_release_id": "pluginrel_60070dc8c3c8819191278d40938c09a9", "plugin_release_skill_id": "pluginrsk_6ad0968f0ecc819186a106b9e605d407", "skill_name": "figma-use", "contents": ["references"], "allow_implicit_invocation": true}}, {"description": "You MUST use this before any creative work - creating features, building components, adding functionality, or modifying behavior. Explores user intent, requirements and design before implementation.", "mimeType": "mcp/skill", "name": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/brainstorming", "title": "Brainstorming", "uri": "skill://plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/brainstorming", "_meta": {"plugin_id": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12", "plugin_name": "superpowers", "plugin_release_id": "pluginrel_62b763ee42ec8191af021ad4816bd049", "plugin_release_skill_id": "pluginrsk_6ab6bcf248c08191a12d812c090d834c", "skill_name": "brainstorming", "contents": ["scripts"], "allow_implicit_invocation": true}}, {"description": "Use when starting any conversation - establishes how to find and use skills, requiring skill invocation before ANY response including clarifying questions", "mimeType": "mcp/skill", "name": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/using-superpowers", "title": "Using Superpowers", "uri": "skill://plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/using-superpowers", "_meta": {"plugin_id": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12", "plugin_name": "superpowers", "plugin_release_id": "pluginrel_62b763ee42ec8191af021ad4816bd049", "plugin_release_skill_id": "pluginrsk_6ab6bcf3ca448191afe0a8de9bda087a", "skill_name": "using-superpowers", "contents": ["references"], "allow_implicit_invocation": true}}, {"description": "Use when encountering any bug, test failure, or unexpected behavior, before proposing fixes", "mimeType": "mcp/skill", "name": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/systematic-debugging", "title": "Systematic Debugging", "uri": "skill://plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/systematic-debugging", "_meta": {"plugin_id": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12", "plugin_name": "superpowers", "plugin_release_id": "pluginrel_62b763ee42ec8191af021ad4816bd049", "plugin_release_skill_id": "pluginrsk_6ab6bcf164f08191824276371f1eaa0e", "skill_name": "systematic-debugging", "contents": [], "allow_implicit_invocation": true}}, {"description": "Use when about to claim work is complete, fixed, or passing, before committing or creating PRs - requires running verification commands and confirming output before making any success claims; evidence before assertions always", "mimeType": "mcp/skill", "name": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/verification-before-completion", "title": "Verification Before Completion", "uri": "skill://plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/verification-before-completion", "_meta": {"plugin_id": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12", "plugin_name": "superpowers", "plugin_release_id": "pluginrel_62b763ee42ec8191af021ad4816bd049", "plugin_release_skill_id": "pluginrsk_6ab6bcf149348191a0958ea70a377330", "skill_name": "verification-before-completion", "contents": [], "allow_implicit_invocation": true}}, {"description": "Use when Product Design is explicitly invoked, or when the user's main goal is to explore a design, research UX, audit or critique a flow, faithfully clone a visual source, check a built design, or share a prototype. Do not use Product Design for ordinary implementation unless the user explicitly asks for it.", "mimeType": "mcp/skill", "name": "Plugin_fa77aec24fc08191bc6e57f377126d76/index", "title": "Product Design", "uri": "skill://Plugin_fa77aec24fc08191bc6e57f377126d76/index", "_meta": {"plugin_id": "Plugin_fa77aec24fc08191bc6e57f377126d76", "plugin_name": "product-design", "plugin_release_id": "pluginrel_6ab53765b77c8191b08bdc8611976edc", "plugin_release_skill_id": "pluginrsk_6ab5377185d88191a735a96671b93f8f", "skill_name": "index", "contents": [], "allow_implicit_invocation": true}}, {"description": "Route customer- and revenue-facing work through Sales first: seller and leadership dashboards, prospects, accounts, calls, deal and renewal strategy, pipeline, forecasts, commercial research, internal support, business cases, sales presentations, customer-facing slides, PowerPoint, Google Slides, coaching, and verbatim customer quotes from supplied call notes. Activate for seller, leader, customer, prospect, partner, account, opportunity, or commercial intent; read this index and the focused workflow even when evidence is supplied.", "mimeType": "mcp/skill", "name": "Plugin_af5b4b796b588191b3f2c610aa093799/index", "title": "Index", "uri": "skill://Plugin_af5b4b796b588191b3f2c610aa093799/index", "_meta": {"plugin_id": "Plugin_af5b4b796b588191b3f2c610aa093799", "plugin_name": "sales", "plugin_release_id": "pluginrel_6acea13dcc0c81918b3ec4ff47fe3ae2", "plugin_release_skill_id": "pluginrsk_6acea13f7a1081919f4f9be1a0ee0cad", "skill_name": "index", "contents": ["references"], "allow_implicit_invocation": true}}, {"description": "Use when you have a spec or requirements for a multi-step task, before touching code", "mimeType": "mcp/skill", "name": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/writing-plans", "title": "Writing Plans", "uri": "skill://plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/writing-plans", "_meta": {"plugin_id": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12", "plugin_name": "superpowers", "plugin_release_id": "pluginrel_62b763ee42ec8191af021ad4816bd049", "plugin_release_skill_id": "pluginrsk_6ab6bcf0b85c81918e84c4cc3b7aaf04", "skill_name": "writing-plans", "contents": [], "allow_implicit_invocation": true}}, {"description": "Use when implementing any feature or bugfix, before writing implementation code", "mimeType": "mcp/skill", "name": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/test-driven-development", "title": "Test-Driven Development", "uri": "skill://plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/test-driven-development", "_meta": {"plugin_id": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12", "plugin_name": "superpowers", "plugin_release_id": "pluginrel_62b763ee42ec8191af021ad4816bd049", "plugin_release_skill_id": "pluginrsk_6ab6bcf3da5c81918a63a15069a30e9f", "skill_name": "test-driven-development", "contents": [], "allow_implicit_invocation": true}}, {"description": "Route Public Equity Investing workflows for listed-company and public-security research, earnings analysis, valuation, model updates, long/short pitches, catalysts, thesis tracking, ETF/index and constituent diligence, position sizing, hedging, dashboards, and investment memos. Use when the user is evaluating a public company, ticker, sector, portfolio position, event, earnings setup, or investment thesis through an investor lens, including what is priced in, what is mispriced, what proves or kills the thesis, and what to watch next. Do not use for private-company diligence, credit-first analysis, personal financial advice, generic company summaries, or generic document drafting with no public-equity investment context.", "mimeType": "mcp/skill", "name": "Plugin_b31b1ece54648191a6760ea4580bba3e/public-equity-investing", "title": "Public Equity Investing", "uri": "skill://Plugin_b31b1ece54648191a6760ea4580bba3e/public-equity-investing", "_meta": {"plugin_id": "Plugin_b31b1ece54648191a6760ea4580bba3e", "plugin_name": "public-equity-investing", "plugin_release_id": "pluginrel_6a9763b1e3ac8191aa34ebef431cee1b", "plugin_release_skill_id": "pluginrsk_6a9763b34a4c819193979b8688334941", "skill_name": "public-equity-investing", "contents": ["internal-support"], "allow_implicit_invocation": true}}, {"description": "Use when doing ANY task involving Supabase. Triggers: Supabase products (Database, Auth, Edge Functions, Realtime, Storage, Vectors, Cron, Queues); client libraries and SSR integrations (supabase-js, @supabase/ssr) in Next.js, React, SvelteKit, Astro, Remix; auth issues (login, logout, sessions, JWT, cookies, getSession, getUser, getClaims, RLS); Supabase CLI or MCP server; schema changes, migrations, security audits, Postgres extensions (pg_graphql, pg_cron, pg_vector).", "mimeType": "mcp/skill", "name": "plugin_asdk_app_69d3e5ee6a708191baa733f7b8931995/supabase", "title": "supabase", "uri": "skill://plugin_asdk_app_69d3e5ee6a708191baa733f7b8931995/supabase", "_meta": {"plugin_id": "plugin_asdk_app_69d3e5ee6a708191baa733f7b8931995", "plugin_name": "supabase", "plugin_release_id": "pluginrel_84a4970e3a6c81918fdf01f6ead22c97", "plugin_release_skill_id": "pluginrsk_1be126dbe5308191922b684a378291ac", "skill_name": "supabase", "contents": ["assets", "references"], "allow_implicit_invocation": true}}, {"description": "Use this skill alongside figma-use when the task involves translating an application page, view, or multi-section layout into Figma. Triggers: 'write to Figma', 'create in Figma from code', 'push page to Figma', 'take this app/page and build it in Figma', 'create a screen', 'build a landing page in Figma', 'update the Figma screen to match code', 'convert this modal/dialog/drawer/panel to Figma'. This is the preferred workflow skill whenever the user wants to build or update a full page, modal, dialog, drawer, sidebar, panel, or any composed multi-section view in Figma from code or a description. Discovers design system components, variables, and styles from Code Connect files, existing screens, and library search, then imports them and assembles views incrementally section-by-section using design system tokens instead of hardcoded values.", "mimeType": "mcp/skill", "name": "plugin_connector_68df038e0ba48191908c8434991bbac2/figma-generate-design", "title": "figma-generate-design", "uri": "skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-generate-design", "_meta": {"plugin_id": "plugin_connector_68df038e0ba48191908c8434991bbac2", "plugin_name": "figma", "plugin_release_id": "pluginrel_60070dc8c3c8819191278d40938c09a9", "plugin_release_skill_id": "pluginrsk_6ad0968fba2c81918f804d994ba4830c", "skill_name": "figma-generate-design", "contents": ["references"], "allow_implicit_invocation": true}}, {"description": "Use when executing an implementation plan in the current session as the implementer yourself \u2014 your human partner chose inline execution, or no subagent tool is available", "mimeType": "mcp/skill", "name": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/executing-plans", "title": "Executing Plans", "uri": "skill://plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/executing-plans", "_meta": {"plugin_id": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12", "plugin_name": "superpowers", "plugin_release_id": "pluginrel_62b763ee42ec8191af021ad4816bd049", "plugin_release_skill_id": "pluginrsk_6ab6bcefd7b88191b308929dbc45c5cb", "skill_name": "executing-plans", "contents": ["scripts"], "allow_implicit_invocation": true}}, {"description": "Always use this skill when the user wants to create a new Figma Design, FigJam, or Slides file. You MUST invoke this skill BEFORE every `create_new_file` tool call.", "mimeType": "mcp/skill", "name": "plugin_connector_68df038e0ba48191908c8434991bbac2/figma-create-new-file", "title": "figma-create-new-file", "uri": "skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-create-new-file", "_meta": {"plugin_id": "plugin_connector_68df038e0ba48191908c8434991bbac2", "plugin_name": "figma", "plugin_release_id": "pluginrel_60070dc8c3c8819191278d40938c09a9", "plugin_release_skill_id": "pluginrsk_6ad0968da74c81919173f566047b27cb", "skill_name": "figma-create-new-file", "contents": [], "allow_implicit_invocation": true}}, {"description": "Use when starting feature work that needs isolation from current workspace or before executing implementation plans - ensures an isolated workspace exists via native tools or git worktree fallback", "mimeType": "mcp/skill", "name": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/using-git-worktrees", "title": "Using Git Worktrees", "uri": "skill://plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/using-git-worktrees", "_meta": {"plugin_id": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12", "plugin_name": "superpowers", "plugin_release_id": "pluginrel_62b763ee42ec8191af021ad4816bd049", "plugin_release_skill_id": "pluginrsk_6ab6bcf3b9dc8191adaedd9d760a366a", "skill_name": "using-git-worktrees", "contents": [], "allow_implicit_invocation": true}}, {"description": "Use when implementation is complete, all tests pass, and you need to decide how to integrate the work", "mimeType": "mcp/skill", "name": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/finishing-a-development-branch", "title": "Finishing a Development Branch", "uri": "skill://plugins~Plugin_60aea7460bd4819199fd97a9553a5e12/finishing-a-development-branch", "_meta": {"plugin_id": "plugins~Plugin_60aea7460bd4819199fd97a9553a5e12", "plugin_name": "superpowers", "plugin_release_id": "pluginrel_62b763ee42ec8191af021ad4816bd049", "plugin_release_skill_id": "pluginrsk_6ab6bcefd4e481918475075a767ff845", "skill_name": "finishing-a-development-branch", "contents": [], "allow_implicit_invocation": true}}, {"description": "Build or update a professional-grade design system in Figma from a codebase. Use when the user wants to create variables/tokens, build component libraries, create individual components with proper variant sets and variable bindings, set up theming (light/dark modes), document foundations, or reconcile gaps between code and Figma. Also use when the user asks to create or generate any component in Figma \u2014 even a single one \u2014 since components require proper variable foundations, variant states, and design token bindings to be production-quality. This skill teaches WHAT to build and in WHAT ORDER \u2014 it complements the `figma-use` skill which teaches HOW to call the Plugin API. Both skills should be loaded together.", "mimeType": "mcp/skill", "name": "plugin_connector_68df038e0ba48191908c8434991bbac2/figma-generate-library", "title": "figma-generate-library", "uri": "skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-generate-library", "_meta": {"plugin_id": "plugin_connector_68df038e0ba48191908c8434991bbac2", "plugin_name": "figma", "plugin_release_id": "pluginrel_60070dc8c3c8819191278d40938c09a9", "plugin_release_skill_id": "pluginrsk_6ad096900ae48191a703c4c2e49a369a", "skill_name": "figma-generate-library", "contents": ["references", "scripts"], "allow_implicit_invocation": true}}, {"description": "Use when triaging public-equity idea candidates. Do not use for final trade recommendations, pitches, memos, or models.", "mimeType": "mcp/skill", "name": "Plugin_b31b1ece54648191a6760ea4580bba3e/idea-generation", "title": "Idea Generation", "uri": "skill://Plugin_b31b1ece54648191a6760ea4580bba3e/idea-generation", "_meta": {"plugin_id": "Plugin_b31b1ece54648191a6760ea4580bba3e", "plugin_name": "public-equity-investing", "plugin_release_id": "pluginrel_6a9763b1e3ac8191aa34ebef431cee1b", "plugin_release_skill_id": "pluginrsk_6a9763b34a3c8191aebedec988991174", "skill_name": "idea-generation", "contents": ["references", "scripts"], "allow_implicit_invocation": false}}, {"description": "Route Investment Banking workflows for banker-owned transaction, capital markets, valuation, diligence, buyer/investor targeting, pitch, process, and restructuring work. Use when the user is preparing, reviewing, or executing M&A, financing, sponsor, issuer, lender, restructuring, coverage, or deal-advisory work, including CIMs, teasers, pitch materials, buyer lists, process trackers, merger models, capital markets analysis, and banker-facing valuation or diligence outputs. Do not use for public-equity investment decisions, personal financial advice, legal advice, FP&A, or generic writing tasks with no transaction or banker-workflow context.", "mimeType": "mcp/skill", "name": "Plugin_68c39ea2b3888191827c933053f3a1d1/investment-banking", "title": "Investment Banking", "uri": "skill://Plugin_68c39ea2b3888191827c933053f3a1d1/investment-banking", "_meta": {"plugin_id": "Plugin_68c39ea2b3888191827c933053f3a1d1", "plugin_name": "investment-banking", "plugin_release_id": "pluginrel_6a9762f9fe308191b4fed932e04e5430", "plugin_release_skill_id": "pluginrsk_6a9762fb83ac8191ad18aee799713338", "skill_name": "investment-banking", "contents": ["internal-support"], "allow_implicit_invocation": true}}, {"description": "Use when the user wants to create, explore, adapt, refine, polish, or review visual creative such as campaigns, ads, social posts, product imagery, scenes, offers, logos, brand systems, styles, charts, decks, or related marketing and design assets.", "mimeType": "mcp/skill", "name": "Plugin_9e6ca248b5248191ac8c599038990ad9/produce", "title": "Produce", "uri": "skill://Plugin_9e6ca248b5248191ac8c599038990ad9/produce", "_meta": {"plugin_id": "Plugin_9e6ca248b5248191ac8c599038990ad9", "plugin_name": "creative-production", "plugin_release_id": "pluginrel_6a57c143b80481919d95167aab23f3c0", "plugin_release_skill_id": "pluginrsk_6a57c1706a1081919a4f69ce8c6c128f", "skill_name": "produce", "contents": ["helpers", "references"], "allow_implicit_invocation": true}}, {"description": "Vercel deployment and CI/CD expert guidance. Use when deploying, promoting, rolling back, inspecting deployments, building with --prebuilt, or configuring CI workflow files for Vercel.", "mimeType": "mcp/skill", "name": "plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/deployments-cicd", "title": "Deployments Cicd", "uri": "skill://plugin_connector_690a90ec05c881918afb6a55dc9bbaa1/deployments-cicd", "_meta": {"plugin_id": "plugin_connector_690a90ec05c881918afb6a55dc9bbaa1", "plugin_name": "vercel", "plugin_release_id": "pluginrel_e623a8dc1ee88191b6fd75b2b451fac5", "plugin_release_skill_id": "pluginrsk_6ac41ea2dc448191a2618be3d04825b4", "skill_name": "deployments-cicd", "contents": ["references"], "allow_implicit_invocation": true}}, {"description": "Create source-backed banker-facing company, target, borrower, issuer, or counterparty tearsheets. Use for baseline profiles, coverage screens, deal-screen inputs, and meeting context.