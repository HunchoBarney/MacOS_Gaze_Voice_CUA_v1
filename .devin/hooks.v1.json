{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/scripts/hooks/session-context.py\"",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/scripts/hooks/phase-handoff-check.py\"",
          "timeout": 10
        }
      ]
    }
  ]
}
