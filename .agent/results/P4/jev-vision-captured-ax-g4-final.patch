+impl CapturedInputAdmission for AdmittedWindowElement {
+    fn window_identity(&self) -> (i32, u32) {
+        (self.request.pid, self.request.window_id)
+    }
+    fn is_element(&self) -> bool {
+        true
+    }
+    fn mark_input_attempted(&self) {
+        self.input_attempted.store(true, Ordering::Release);
+    }
+    fn validate_live(&self, args: &serde_json::Value) -> Result<(), ToolResult> {
+        let dimensions = live_action_dimensions(&self.admission.target)
+            .map_err(|refusal| self.with_partial_effect(refusal))?;
+        self.validate_with_frame(args, dimensions)
+    }
+    fn before_input(&self) -> anyhow::Result<()> {
+        self.validate_live(&self.origin_args)
+            .map_err(NativeCaptureRefusal)?;
+        self.mark_input_attempted();
+        Ok(())
+    }
+    fn before_key_input(&self) -> anyhow::Result<()> {
+        self.validate_live(&self.origin_args)
+            .map_err(NativeCaptureRefusal)?;
+        self.validate_focus()?;
+        self.mark_input_attempted();
+        Ok(())
+    }
+    fn before_ax_input(&self, element: usize) -> anyhow::Result<()> {
+        self.validate_live(&self.origin_args)
+            .map_err(NativeCaptureRefusal)?;
+        let matches = unsafe {
+            crate::ax::exact_target::element_window_id(
+                element as crate::ax::bindings::AXUIElementRef,
+            )
+        }
+        .is_some_and(|window| window.is(self.request.window_id));
+        if !matches {
+            return Err(NativeCaptureRefusal(self.with_partial_effect(capture_error(
+                "capture_target_mismatch",
+                "AX input no longer belongs to the captured window",
+            )))
+            .into());
+        }
+        self.mark_input_attempted();
+        Ok(())
+    }
+    fn before_pointer_input(&self, foreground: bool) -> anyhow::Result<()> {
+        self.validate_live(&self.origin_args)
+            .map_err(NativeCaptureRefusal)?;
+        if self.kind == WindowPixelAction::Click {
+            return Err(NativeCaptureRefusal(self.with_partial_effect(capture_error(
+                "capture_element_unsupported",
+                "native captured click cannot become a pixel click",
+            )))
+            .into());
+        }
+        if foreground {
+            if !self.foreground {
+                return Err(NativeCaptureRefusal(self.with_partial_effect(capture_error(
+                    "capture_target_mismatch",
+                    "foreground input was not admitted",
+                )))
+                .into());
+            }
+            self.validate_focus()?;
+        }
+        self.mark_input_attempted();
+        Ok(())
+    }
+    fn finish_result(&self, result: ToolResult) -> ToolResult {
+        if result.is_error == Some(true) {
+            self.with_partial_effect(result)
+        } else {
+            result
+        }
+    }
+}
