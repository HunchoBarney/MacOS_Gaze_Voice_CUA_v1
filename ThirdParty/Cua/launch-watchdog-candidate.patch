 mod tests {
     use super::*;
     use std::sync::Arc;
+
+    #[test]
+    fn explicit_foreground_retires_only_matching_launch_watchdogs() {
+        let d = Arc::new(Dispatcher::new());
+        let matching = d.add_launch_watchdog(42, 7);
+        let other = d.add_launch_watchdog(99, 8);
+        let _ordinary = d.add(Some(42), 9, "ClickTool");
+        let _wildcard = d.add(None, 10, "LaunchAppTool.pre");
+        assert!(matching.restore_if_active(|| {}));
+        d.retire_launch_watchdogs(42);
+        assert!(!matching.restore_if_active(|| panic!("retired manual restore ran")));
+        assert!(other.restore_if_active(|| {}));
+        let mut remaining = d.snapshot_matches(42);
+        remaining.sort_unstable();
+        assert_eq!(remaining, vec![9, 10]);
+        assert!(d.snapshot_matches(99).contains(&8));
+        // Explicit foreground does not exempt future background launches.
+        let later = d.add_launch_watchdog(42, 11);
+        assert!(later.restore_if_active(|| {}));
+        assert!(d.snapshot_matches(42).contains(&11));
+    }
+
+    #[test]
+    fn retired_watchdog_cannot_restore_from_a_queued_observer_snapshot() {
+        let d = Arc::new(Dispatcher::new());
+        let watchdog = d.add_launch_watchdog(42, 7);
+        let queued = d.restore_requests(42);
+        assert_eq!(queued.len(), 1);
+        d.retire_launch_watchdogs(42);
+        for request in queued {
+            request.run(|| panic!("queued observer restored after retirement"));
+        }
+        assert!(!watchdog.restore_if_active(|| panic!("manual watchdog restored")));
+    }
+
+    #[test]
+    fn expired_observer_entry_keeps_timer_retirable_until_watchdog_drops() {
+        let d = Arc::new(Dispatcher::new());
+        let watchdog = d.add_launch_watchdog(42, 7);
+        for entry in d.entries.lock().unwrap().values_mut() {
+            entry.deadline = Instant::now() - Duration::from_secs(1);
+        }
+        d.reap_expired();
+        assert!(
+            d.restore_requests(42).is_empty(),
+            "observer deadline still applies"
+        );
+        assert!(
+            watchdog.restore_if_active(|| {}),
+            "existing eight-second timer remains active"
+        );
+        d.retire_launch_watchdogs(42);
+        assert!(!watchdog.restore_if_active(|| panic!("expired observer hid a live timer")));
+        drop(watchdog);
+        assert_eq!(d.len(), 0);
+    }
+
+    #[test]
+    fn foreground_retirement_waits_for_an_already_running_restore() {
+        let d = Arc::new(Dispatcher::new());
+        let watchdog = d.add_launch_watchdog(42, 7);
+        let request = d.restore_requests(42).pop().unwrap();
+        let (started_tx, started_rx) = std::sync::mpsc::channel();
+        let (finish_tx, finish_rx) = std::sync::mpsc::channel();
+        let restore = std::thread::spawn(move || {
+            request.run(|| {
+                started_tx.send(()).unwrap();
+                finish_rx.recv().unwrap();
+            })
+        });
+        started_rx.recv().unwrap();
+        let (retired_tx, retired_rx) = std::sync::mpsc::channel();
+        let retiring: Vec<_> = (0..2)
+            .map(|_| {
+                let d = Arc::clone(&d);
+                let retired_tx = retired_tx.clone();
+                std::thread::spawn(move || {
+                    d.retire_launch_watchdogs(42);
+                    retired_tx.send(()).unwrap();
+                })
+            })
+            .collect();
+        assert!(retired_rx.recv_timeout(Duration::from_millis(30)).is_err());
+        finish_tx.send(()).unwrap();
+        restore.join().unwrap();
+        for thread in retiring {
+            thread.join().unwrap();
+        }
+        retired_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+        retired_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+        assert!(!watchdog.restore_if_active(|| panic!("restore survived retirement")));
+    }
 
